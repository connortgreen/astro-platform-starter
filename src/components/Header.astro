---
import Logo from '../components/Logo.astro';

const navItems = [
    { linkText: 'Home', href: '/' },
    { linkText: 'Projects', href: '/projects' },
    { linkText: 'Contact', href: '/contact' }
];

const currentPath = new URL(Astro.request.url).pathname;
---

<header class="flex flex-wrap items-center justify-between gap-4 pt-8 pb-16 sm:pt-12 sm:pb-24">
    <a href="/" class="plain text-ink hover:text-primary transition-colors">
        <Logo />
    </a>
    {
        !!navItems?.length && (
            <nav>
                <ul class="font-mono flex flex-wrap gap-x-6 gap-y-1 text-xs tracking-[0.15em] uppercase">
                    {navItems.map((item) => {
                        const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
                        return (
                            <li>
                                <a
                                    href={item.href}
                                    class:list={[
                                        'plain inline-block border-b py-1 transition-colors',
                                        isActive ? 'border-primary text-primary' : 'border-transparent text-ink-soft hover:text-ink hover:border-ink-faint'
                                    ]}
                                >
                                    {item.linkText}
                                </a>
                            </li>
                        );
                    })}
                </ul>
            </nav>
        )
    }
</header>
