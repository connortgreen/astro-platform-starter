---
interface Props {
    class?: string;
}

const { class: className } = Astro.props;
---

<span class:list={['flex items-center gap-2.5', className]}>
    <svg width="34" height="34" viewBox="0 0 34 34" fill="none" xmlns="http://www.w3.org/2000/svg" class="shrink-0">
        <rect x="0.5" y="0.5" width="33" height="33" stroke="currentColor" stroke-opacity="0.35" />
        <path d="M17 3.5L17 8.5" stroke="currentColor" stroke-opacity="0.35" />
        <path d="M17 25.5L17 30.5" stroke="currentColor" stroke-opacity="0.35" />
        <path d="M3.5 17L8.5 17" stroke="currentColor" stroke-opacity="0.35" />
        <path d="M25.5 17L30.5 17" stroke="currentColor" stroke-opacity="0.35" />
        <text x="17" y="21.5" text-anchor="middle" font-family="'IBM Plex Mono', monospace" font-size="12" letter-spacing="0.5" fill="currentColor">CG</text>
    </svg>
    <span class="font-display text-lg leading-none">Connor Green</span>
</span>
